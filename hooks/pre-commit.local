#!/usr/bin/env bash
# local-jobs repo-local pre-commit: run the hermetic conformance harness (quick
# mode) whenever framework code is staged.
#
# This is chained AFTER the KleinPerkins/dev managed guards (session-lock,
# identity-guard, data-guard, registration-guard) by the installed
# .git/hooks/pre-commit dispatcher, which exec's "$HOOK_DIR/pre-commit.local"
# if present. Source-tracked; install/repair with bin/install-hooks.sh.
#
# Docs-only commits stay instant — the harness only runs when a framework file
# is staged. Override (discouraged) with LOCAL_JOBS_SKIP_HOOK=1.
set -uo pipefail

[[ "${LOCAL_JOBS_SKIP_HOOK:-0}" == "1" ]] && exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$staged" | grep -Eq '^(lib/|bin/|handlers/|backends/|config/registry\.yml|config/jobs/|hooks/)'; then
  exit 0
fi

log="$(mktemp -t local-jobs-precommit.XXXXXX)"
printf 'local-jobs: framework change detected — running hermetic conformance (quick)...\n'
if bash bin/test-local-jobs.sh quick >"$log" 2>&1; then
  rm -f "$log"
  printf 'local-jobs: conformance OK\n'
  exit 0
fi

printf 'local-jobs pre-commit BLOCKED — the conformance harness did not pass:\n' >&2
tail -40 "$log" >&2
printf '(full log: %s — override with LOCAL_JOBS_SKIP_HOOK=1, not recommended)\n' "$log" >&2
exit 1
